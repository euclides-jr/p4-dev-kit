component DemoButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    min-width: 150px;
    height: 100px;
    border-radius: 20px;
    background: touch.pressed ? #136c65 : #27566a;

    Text {
        text: root.label;
        color: #f2f7ff;
        font-size: 30px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component DemoScreen inherits Window {
    in property <image> camera-frame;
    in property <bool> camera-ready;
    in property <bool> camera-overlay;
    out property <int> camera-x: preview.absolute-position.x / 1px;
    out property <int> camera-y: preview.absolute-position.y / 1px;
    out property <int> count: 0;
    width: 720px;
    height: 1280px;
    background: #0d1727;

    VerticalLayout {
        padding: 48px;
        spacing: 24px;
        alignment: center;

        Text {
            text: "ESP32-P4";
            color: #59eed0;
            font-size: 28px;
            font-weight: 700;
        }
        Text {
            text: "Slint demo";
            color: #f2f7ff;
            font-size: 76px;
            font-weight: 700;
        }
        Rectangle {
            height: 160px;
            background: #1a2b43;
            border-radius: 24px;
            VerticalLayout {
                padding: 28px;
                alignment: center;
                spacing: 8px;
                Text {
                    text: "MIPI DSI DISPLAY";
                    color: #a7bcd3;
                    font-size: 24px;
                }
                Text {
                    text: "720 x 1280  /  RGB565";
                    color: #f2f7ff;
                    font-size: 38px;
                }
            }
        }
        Rectangle {
            height: 360px;
            preview := Rectangle {
                width: 640px;
                height: 360px;
                x: (parent.width - self.width) / 2;
                background: root.camera-ready ? #080f19 : #0a1220;
                Image {
                    visible: root.camera-ready && !root.camera-overlay;
                    width: parent.width;
                    height: parent.height;
                    source: root.camera-frame;
                    image-fit: contain;
                }
                Text {
                    visible: !root.camera-ready;
                    text: "Waiting for USB camera";
                    color: #a7bcd3;
                    font-size: 26px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
        Text {
            text: "Count: " + root.count;
            color: #f2f7ff;
            font-size: 52px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            spacing: 16px;
            DemoButton {
                label: "−";
                clicked => { root.count -= 1; }
            }
            DemoButton {
                label: "Reset";
                clicked => { root.count = 0; }
            }
            DemoButton {
                label: "+";
                clicked => { root.count += 1; }
            }
        }
        Rectangle {
            height: 10px;
            border-radius: 5px;
            background: #59eed0;
        }
    }
}
